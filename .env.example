# Copy to .env and change what you need. Everything here is optional.

# Speech to text. small is quick; medium or large-v3 is noticeably better for
# Hindi and other Indian languages, but slower on CPU.
WHISPER_MODEL=small
# Set when most of your clips are one language (hi, en, ta, te, ...). Empty = auto-detect.
DEFAULT_LANGUAGE=

# Face recognition. To skip it: WITH_FACES=0 (build) and ENABLE_FACES=0 (run).
WITH_FACES=1
ENABLE_FACES=1
# Cosine similarity needed to call two faces the same person. Raise it if you
# get wrong names, lower it if known people are missed.
FACE_MATCH_THRESHOLD=0.42

# Ranking. score = W_KEYWORD * keyword + W_SEMANTIC * meaning + small popularity bonus.
W_KEYWORD=0.65
W_SEMANTIC=0.35
# A clip is shown only if its keyword match OR its meaning match clears these.
MIN_KEYWORD=0.35
MIN_SEMANTIC=0.45

# Clips longer than this are rejected.
MAX_CLIP_SECONDS=30

# Mood / use-when / description, from local models only (no LLM, nothing leaves
# the machine): facial expressions (FER+), scene mood (CLIP), dialogue tone.
# Sidecar or hand-edited values are never overwritten. Raise VIBE_MIN_SCORE for
# fewer, surer mood tags.
ENABLE_VIBE=1
VIBE_MIN_SCORE=0.30

# Laya (typed yes/no and choice decisions over text, no text generation) runs as
# the `laya` service. At ingest it tags each clip with topics (work, politics,
# late, roast ...) and reads the mood of title + dialogue; at search it reads
# what the query is about and boosts clips with those topics or moods.
# Empty LAYA_URL turns it off; ingest and search then work as before.
LAYA_URL=http://laya:8000
LAYA_MODEL=multilingual
# Probability a topic needs to be kept on a clip, and the probability a query
# needs to count as "about" a topic or mood.
LAYA_TOPIC_MIN=0.45
LAYA_QUERY_MIN=0.3
# Weight of the topic match in the search score, and the match needed to show
# a clip on topic alone.
W_TOPIC=0.25
MIN_TOPIC=0.5

# Public https address of this server, used in share links (/c/<id>) and the
# video previews chat apps draw from them. Chat apps cannot reach localhost, so
# previews only work once this points at a real domain (e.g. a Cloudflare Tunnel).
PUBLIC_BASE_URL=
# e.g. PUBLIC_BASE_URL=https://memeclip.aiwroteit.dev

# Page design: a file name from app/static/themes/ without .css (picker, sticker,
# viza). Empty = the default in app/config.py. Preview any with /?theme=<name>.
UI_THEME=

# 1 = shares teach search (query -> clip, popularity). Off until real traffic.
LEARN_FROM_SHARES=0
