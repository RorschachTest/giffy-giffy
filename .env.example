# Copy to .env and change what you need. Everything here is optional.

# Speech to text. small is quick; medium or large-v3 is noticeably better for
# Hindi and other Indian languages, but slower on CPU.
WHISPER_MODEL=small
# Set when most of your clips are one language (hi, en, ta, te, ...). Empty = auto-detect.
DEFAULT_LANGUAGE=

# Face recognition. To skip it: WITH_FACES=0 (build) and ENABLE_FACES=0 (run).
WITH_FACES=1
ENABLE_FACES=1
# Cosine similarity needed to call two faces the same person. Raise it if you
# get wrong names, lower it if known people are missed.
FACE_MATCH_THRESHOLD=0.42

# Ranking. score = W_KEYWORD * keyword + W_SEMANTIC * meaning + small popularity bonus.
W_KEYWORD=0.65
W_SEMANTIC=0.35
# A clip is shown only if its keyword match OR its meaning match clears these.
MIN_KEYWORD=0.35
MIN_SEMANTIC=0.45

# Clips longer than this are rejected.
MAX_CLIP_SECONDS=30
