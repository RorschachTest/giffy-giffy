__pycache__/
*.pyc
.env
.venv/
.pytest_cache/

# Runtime data stays on your machine, not in git: clips, photos, logs.
data/**
!data/**/
!data/**/.gitkeep

# copies made by scripts/new_space.sh (data/<name>/...) and its .env backup
data/*/*/.gitkeep
.env.bak

# Private notes and architecture docs: kept on this machine, never pushed.
docs/private/
